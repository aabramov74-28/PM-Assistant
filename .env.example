# ==================== Конфигурация MVP «Ассистент PM» ====================
# Скопируйте этот файл в .env и заполните значения.
# .env не коммитится в git и не должен попадать в общий доступ.

# --- Telegram (обязательно) ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# --- Администраторы ---
# Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_TG_IDS=

# --- Расписания ---
DIGEST_TIME=09:00
WEEKLY_REPORT_DAY=4
WEEKLY_REPORT_TIME=17:00
EOD_SURVEY_TIME=18:00
TZ=Europe/Moscow

# --- Корпоративная почта (неделя 4) ---
# SMTP: порт 465 — SSL, 587 — STARTTLS (выбирается автоматически)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя (если отличается от SMTP_USER, например pm-assistant@company.ru)
MAIL_FROM_ADDRESS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Яндекс 360 Календарь / CalDAV (неделя 4) ---
# Используется пароль приложения: Яндекс ID → Безопасность → Пароли приложений
CALDAV_URL=https://caldav.yandex.ru
CALDAV_USER=
CALDAV_PASSWORD=

# --- LLM-модуль (неделя 3): YandexGPT, OpenAI-совместимый API ---
# Ключ создаётся в Yandex Cloud: Сервисный аккаунт → API-ключ (роль ai.languageModels.user)
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
# Формат модели: gpt://<folder_id>/yandexgpt-lite/latest (или yandexgpt)
LLM_MODEL=
LLM_FOLDER_ID=
# Схема авторизации: Api-Key (Yandex, подставится автоматически) | Bearer
LLM_AUTH_SCHEME=

# --- Прочее ---
DATABASE_PATH=pm_assistant.db
